{
  "name": "n8n-nodes-planvortex",
  "version": "0.1.0",
  "description": "n8n community node for PlanVortex: publish to social networks, upload media, read and reply to comments, and create account connect links.",
  "license": "MIT",
  "homepage": "https://planvortex.com/en/developers",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "planvortex",
    "social-media",
    "publishing",
    "scheduling",
    "discord",
    "telegram",
    "slack"
  ],
  "author": {
    "name": "Talia Softworks",
    "email": "taliasoftworks@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taliasoftworks/n8n-nodes-planvortex.git"
  },
  "bugs": {
    "url": "https://github.com/taliasoftworks/n8n-nodes-planvortex/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "node scripts/scan-local.mjs",
    "credentials:check": "node scripts/check-credentials.mjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PlanVortexOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PlanVortex/PlanVortex.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.49.1",
    "@n8n/scan-community-package": "^0.36.0",
    "eslint": "9.32.0",
    "glob": "^11.1.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
